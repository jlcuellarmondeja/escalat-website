---
import Logo from "./Logo.astro";
import { useT, getLang, localePath, legalPaths } from "../i18n/ui";

const locale = Astro.currentLocale;
const lang = getLang(locale);
const t = useT(locale).footer;
const legal = legalPaths[lang];
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo href={localePath("/", locale)} />
      <p>{t.tagline}</p>
    </div>

    <div class="site-footer__cols">
      <div>
        <h4>Escalat</h4>
        <a href={localePath("/#servicios", locale)}>{t.services}</a>
        <a href={localePath("/#como-funciona", locale)}>{t.how}</a>
        <a href={localePath("/#sobre", locale)}>{t.about}</a>
        <a href={localePath("/#contacto", locale)}>{t.contact}</a>
      </div>
      <div>
        <h4>{t.legalTitle}</h4>
        <a href={legal.notice}>{t.legalNotice}</a>
        <a href={legal.privacy}>{t.privacy}</a>
      </div>
      <div>
        <h4>{t.talkTitle}</h4>
        <a href="mailto:contacto@escalat.es">contacto@escalat.es</a>
        <a href={localePath("/#contacto", locale)}>{t.callback}</a>
      </div>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <span>© {year} Escalat. {t.rights}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-2);
    padding-top: 56px;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.3fr 2fr;
    gap: 48px;
  }
  .site-footer__brand p {
    margin-top: 16px;
    color: var(--color-text-2);
    font-size: 15px;
    max-width: 34ch;
  }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .site-footer__cols h4 {
    font-family: var(--font-sans);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 14px;
  }
  .site-footer__cols a {
    display: block;
    padding: 5px 0;
    color: var(--color-text-2);
    font-size: 15px;
    transition: color 0.2s ease;
  }
  .site-footer__cols a:hover { color: var(--color-gold-soft); }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 48px;
    padding-top: 24px;
    padding-bottom: 32px;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 13px;
  }

  @media (max-width: 720px) {
    .site-footer__inner { grid-template-columns: 1fr; gap: 36px; }
    .site-footer__cols { grid-template-columns: repeat(2, 1fr); }
  }
</style>
