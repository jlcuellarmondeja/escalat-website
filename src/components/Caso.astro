---
import Icon from "./Icon.astro";
import { useT } from "../i18n/ui";
const t = useT(Astro.currentLocale).caso;
const pointIcons = ["clock", "send", "shield"];
---
<section class="section section--alt" id="caso">
  <div class="container">
    <div class="caso__card reveal">
      <div class="caso__content">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="caso__title">{t.title}</h2>
        <p class="caso__desc">{t.desc}</p>
        <ul class="caso__points">
          {t.points.map((p, i) => (
            <li><Icon name={pointIcons[i]} size={18} /> {p}</li>
          ))}
        </ul>
        <p class="caso__foot">
          {t.footPre}<span class="text-gold">{t.footAccent}</span>{t.footPost}
        </p>
      </div>

      <div class="caso__demo" aria-hidden="true">
        <div class="tg">
          <div class="tg__bar">
            <span class="tg__avatar"><Icon name="robot" size={18} /></span>
            <div>
              <div class="tg__name">{t.demo.name}</div>
              <div class="tg__status">{t.demo.status}</div>
            </div>
          </div>
          <div class="tg__body">
            <div class="tg__msg">
              <strong>{t.demo.alertTitle}</strong><br />
              {t.demo.alertBody}
              <span class="tg__time">{t.demo.time1}</span>
            </div>
            <div class="tg__msg tg__msg--muted">
              {t.demo.recheck}
              <span class="tg__time">{t.demo.time2}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .caso__card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(28px, 5vw, 52px);
  }
  .caso__title { font-size: clamp(26px, 3.5vw, 36px); margin: 14px 0 16px; }
  .caso__desc { color: var(--color-text-2); font-size: 17px; }
  .caso__points {
    list-style: none; padding: 0; margin: 22px 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .caso__points li {
    display: flex; align-items: center; gap: 10px;
    color: var(--color-text); font-size: 15.5px;
  }
  .caso__points :global(svg) { color: var(--color-gold); flex: none; }
  .caso__foot { color: var(--color-text-2); font-size: 15.5px; }

  .tg {
    background: var(--color-bg);
    border: 1px solid var(--color-border-2);
    border-radius: 14px;
    overflow: hidden;
    max-width: 340px;
    margin-inline: auto;
  }
  .tg__bar {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    background: var(--color-bg-2);
    border-bottom: 1px solid var(--color-border);
  }
  .tg__avatar {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--color-gold); color: var(--color-bg);
    display: flex; align-items: center; justify-content: center;
  }
  .tg__name { font-weight: 500; font-size: 14px; }
  .tg__status { font-size: 12px; color: var(--color-muted); }
  .tg__body { padding: 16px 14px; display: flex; flex-direction: column; gap: 10px; }
  .tg__msg {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px 12px 12px 4px;
    padding: 10px 12px 20px;
    font-size: 13.5px;
    color: var(--color-text);
    line-height: 1.5;
  }
  .tg__msg--muted { color: var(--color-muted); }
  .tg__time {
    position: absolute; right: 10px; bottom: 6px;
    font-size: 11px; color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .caso__card { grid-template-columns: 1fr; }
    .caso__demo { order: -1; }
  }
</style>
