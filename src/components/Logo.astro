---
interface Props {
  showText?: boolean;
  size?: number;
  href?: string | null;
}
const { showText = true, size = 26, href = "/" } = Astro.props;
const Tag = href ? "a" : "span";
---
<Tag class="logo" {...href ? { href } : {}} aria-label="Escalat — inicio">
  <svg
    class="logo__mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    role="img"
    aria-hidden="true"
    fill="none"
  >
    <path d="M4 21 L10 18 L16 21 L10 24 Z" fill="currentColor" stroke="var(--color-bg)" stroke-width="0.9" />
    <path d="M10 16 L16 13 L22 16 L16 19 Z" fill="currentColor" stroke="var(--color-bg)" stroke-width="0.9" />
    <path d="M16 11 L22 8 L28 11 L22 14 Z" fill="currentColor" stroke="var(--color-bg)" stroke-width="0.9" />
  </svg>
  {showText && <span class="logo__text">Escalat</span>}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-gold);
  }
  .logo__mark { flex: none; }
  .logo__text {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 1.35rem;
    letter-spacing: 0.01em;
    color: var(--color-gold);
  }
</style>
