---
import Icon from "./Icon.astro";
import { useT } from "../i18n/ui";
const t = useT(Astro.currentLocale).servicios;
const icons = ["chat", "phone", "calendar", "users", "truck", "bolt"];
const servicios = t.items.map((item, i) => ({ ...item, icon: icons[i] }));
---
<section class="section section--alt" id="servicios">
  <div class="container">
    <div class="servicios__head reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-intro">{t.intro}</p>
    </div>

    <div class="servicios__grid">
      {servicios.map((s) => (
        <article class="card servicio reveal">
          <span class="servicio__icon"><Icon name={s.icon} size={24} /></span>
          <h3 class="servicio__title">{s.title}</h3>
          <p class="servicio__desc">{s.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .servicios__head { margin-bottom: 48px; }
  .servicios__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .servicio__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(201, 162, 39, 0.1);
    border: 1px solid rgba(201, 162, 39, 0.25);
    color: var(--color-gold);
    margin-bottom: 18px;
  }
  .servicio__title { font-size: 21px; margin-bottom: 10px; }
  .servicio__desc { color: var(--color-text-2); font-size: 15.5px; }

  @media (max-width: 900px) {
    .servicios__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .servicios__grid { grid-template-columns: 1fr; }
  }
</style>
