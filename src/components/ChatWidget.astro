---
import Icon from "./Icon.astro";
import { useT, getLang, legalPaths } from "../i18n/ui";
const locale = Astro.currentLocale;
const t = useT(locale).chat;
const privacyHref = legalPaths[getLang(locale)].privacy;
---
<div
  class="chat"
  data-chat
  data-error={t.error}
  data-rate-limit={t.rateLimit}
  data-privacy={privacyHref}
  data-form-t={JSON.stringify(t.form)}
  data-cita-t={JSON.stringify(t.cita)}
  data-llamada-t={JSON.stringify(t.llamada)}
  data-lang={getLang(locale)}
>
  <button class="chat__launcher" data-chat-launcher aria-label={t.name} aria-expanded="false">
    <span class="chat__launcher-icon"><Icon name="robot" size={24} /></span>
    <span class="chat__launcher-text">{t.launcher}</span>
  </button>

  <section class="chat__panel" data-chat-panel hidden aria-label={t.name}>
    <header class="chat__header">
      <span class="chat__avatar"><Icon name="robot" size={20} /></span>
      <div class="chat__id">
        <span class="chat__name">{t.name}</span>
        <span class="chat__state"><span class="chat__dot"></span>{t.online}</span>
      </div>
      <button class="chat__close" data-chat-close aria-label="Cerrar">✕</button>
    </header>

    <div class="chat__log" data-chat-log>
      <div class="msg msg--bot">{t.greeting}</div>
    </div>

    <form class="chat__form" data-chat-form>
      <input
        class="chat__input"
        data-chat-input
        type="text"
        placeholder={t.placeholder}
        autocomplete="off"
        aria-label={t.placeholder}
      />
      <button class="chat__send" type="submit" aria-label="Enviar"><Icon name="send" size={18} /></button>
    </form>
    <p class="chat__legal">{t.legalPre}<a href={privacyHref}>{t.legalLink}</a>.</p>
  </section>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string };

  const root = document.querySelector("[data-chat]") as HTMLElement | null;
  const launcher = document.querySelector<HTMLButtonElement>("[data-chat-launcher]");
  const panel = document.querySelector<HTMLElement>("[data-chat-panel]");
  const log = document.querySelector<HTMLElement>("[data-chat-log]");
  const form = document.querySelector<HTMLFormElement>("[data-chat-form]");
  const input = document.querySelector<HTMLInputElement>("[data-chat-input]");
  const D = root?.dataset ?? {};
  const history: Msg[] = [];

  /** Identifica la conversación para la memoria del workflow de n8n. */
  const sessionId = (() => {
    const key = "escalat:chat-session";
    const fresh = () =>
      crypto.randomUUID?.() ?? `s${Date.now().toString(36)}${Math.random().toString(36).slice(2)}`;
    try {
      const saved = sessionStorage.getItem(key);
      if (saved) return saved;
      const id = fresh();
      sessionStorage.setItem(key, id);
      return id;
    } catch {
      return fresh();
    }
  })();

  function open() {
    panel?.removeAttribute("hidden");
    launcher?.setAttribute("aria-expanded", "true");
    root?.classList.add("is-open");
    setTimeout(() => input?.focus(), 60);
  }
  function close() {
    panel?.setAttribute("hidden", "");
    launcher?.setAttribute("aria-expanded", "false");
    root?.classList.remove("is-open");
  }
  function toggle() {
    if (panel?.hasAttribute("hidden")) open();
    else close();
  }

  launcher?.addEventListener("click", toggle);
  document.querySelector("[data-chat-close]")?.addEventListener("click", close);
  document.querySelectorAll("[data-open-chat]").forEach((b) =>
    b.addEventListener("click", (e) => { e.preventDefault(); open(); })
  );

  const ESCAPES: Record<string, string> = {
    "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
  };

  /**
   * Prepara el texto para pintarlo como HTML.
   *
   * Primero escapa TODO (el texto viene del modelo: no es de fiar), y solo después
   * traduce lo poco que suele soltar en markdown. Así los `**` se ven en negrita en
   * vez de como asteriscos sueltos, y los saltos de línea se respetan.
   */
  function render(text: string): string {
    return text
      .replace(/[&<>"']/g, (c) => ESCAPES[c]!)
      .replace(/\*\*([^*\n]+)\*\*/g, "<strong>$1</strong>")
      .replace(/\n/g, "<br>");
  }

  function addMsg(role: "user" | "bot", text: string): HTMLElement {
    const el = document.createElement("div");
    el.className = `msg msg--${role}`;
    el.innerHTML = render(text);
    log?.appendChild(el);
    if (log) log.scrollTop = log.scrollHeight;
    return el;
  }

  /**
   * Manda un mensaje al asistente y pinta la respuesta.
   *
   * `display` permite enseñar en pantalla algo distinto de lo que se envía, o nada
   * en absoluto (`null`): cuando los datos salen del formulario, el propio formulario
   * relleno ya hace de registro visual y una burbuja repetiría lo mismo.
   */
  async function send(text: string, display: string | null = text): Promise<void> {
    if (display !== null) addMsg("user", display);
    history.push({ role: "user", content: text });

    const typing = addMsg("bot", "…");
    typing.classList.add("msg--typing");

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ sessionId, messages: history, lang: D.lang }),
      });
      if (res.status === 429) {
        typing.classList.remove("msg--typing");
        typing.innerHTML = D.rateLimit || D.error || "";
        history.pop(); // no llegó a haber respuesta: no ensuciamos el historial
        if (log) log.scrollTop = log.scrollHeight;
        return;
      }
      if (!res.ok) throw new Error("bad");
      const data = await res.json();
      const reply = (data && data.reply) || "…";
      typing.classList.remove("msg--typing");
      typing.innerHTML = render(reply);
      history.push({ role: "assistant", content: reply });
      if (data && data.form === "contacto") addLeadForm();
      if (data && data.form === "llamada") addLlamada();
      if (data && data.form === "cita") void addAgenda();
    } catch {
      typing.classList.remove("msg--typing");
      typing.innerHTML = D.error || "Error";
    }
    if (log) log.scrollTop = log.scrollHeight;
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const text = input?.value.trim();
    if (!text) return;
    if (input) input.value = "";
    void send(text);
  });

  // ── Formulario de datos dentro del chat ──────────────────────────────────────

  type Textos = Record<string, string>;
  const leer = (raw?: string): Textos => {
    try {
      return JSON.parse(raw || "{}");
    } catch {
      return {};
    }
  };
  const FT = leer(D.formT);
  const CT = leer(D.citaT);
  const LT = leer(D.llamadaT);
  const LANG = D.lang === "en" ? "en-GB" : "es-ES";

  /** Datos ya facilitados por el visitante, para no volver a pedirlos al reservar. */
  let datos: { nombre: string; email: string; telefono: string } | null = null;

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  /** Un teléfono utilizable: se cuentan los dígitos, se ignora cómo los escriba. */
  const digitos = (s: string) => s.replace(/\D/g, "");

  /**
   * Pinta el formulario de datos como una burbuja más del hilo.
   *
   * Los campos y sus validaciones están aquí, no en n8n: el agente solo decide
   * CUÁNDO pedirlos. Así el visitante ve siempre lo mismo y el email se valida de
   * verdad, en vez de depender de que el modelo lo interprete bien.
   */
  function addLeadForm(): void {
    if (!log || log.querySelector("[data-lead-form]")) return; // solo una vez

    const el = document.createElement("form");
    el.className = "lead";
    el.setAttribute("data-lead-form", "");
    el.noValidate = true;
    el.innerHTML = `
      <p class="lead__title">${FT.title || ""}</p>
      <p class="lead__intro">${FT.intro || ""}</p>
      <label class="lead__label" for="lead-name">${FT.name || ""}</label>
      <input class="lead__input" id="lead-name" name="nombre" type="text"
             placeholder="${FT.namePh || ""}" autocomplete="name" required />
      <label class="lead__label" for="lead-email">${FT.email || ""}</label>
      <input class="lead__input" id="lead-email" name="email" type="email"
             placeholder="${FT.emailPh || ""}" autocomplete="email" required />
      <label class="lead__label" for="lead-phone">${FT.phone || ""}</label>
      <input class="lead__input" id="lead-phone" name="telefono" type="tel"
             placeholder="${FT.phonePh || ""}" autocomplete="tel" required />
      <label class="lead__consent">
        <input type="checkbox" name="consent" />
        <span>${FT.consentPre || ""}<a href="${D.privacy || "#"}" target="_blank" rel="noopener">${FT.consentLink || ""}</a>.</span>
      </label>
      <p class="lead__error" role="alert" aria-live="polite"></p>
      <button class="lead__submit" type="submit">${FT.submit || ""}</button>
    `;

    const error = el.querySelector<HTMLParagraphElement>(".lead__error")!;
    const button = el.querySelector<HTMLButtonElement>(".lead__submit")!;

    el.addEventListener("submit", (e) => {
      e.preventDefault();
      const data = new FormData(el);
      const nombre = String(data.get("nombre") || "").trim();
      const email = String(data.get("email") || "").trim();
      const telefono = String(data.get("telefono") || "").trim();

      if (!nombre) return fail(FT.errName);
      if (!EMAIL_RE.test(email)) return fail(FT.errEmail);
      // El teléfono ya no es opcional: la salida natural de la conversación es una
      // llamada, y pedirlo dos veces (aquí y luego en el formulario de llamada) es
      // una fricción tonta.
      const n = digitos(telefono).length;
      if (n < 9 || n > 15) return fail(FT.errPhone);
      if (!data.get("consent")) return fail(FT.errConsent);

      error.textContent = "";
      button.disabled = true;
      button.textContent = FT.sending || "…";

      // El formulario se queda visible pero bloqueado: el visitante ve lo que envió.
      el.querySelectorAll("input").forEach((i) => (i.disabled = true));
      el.classList.add("is-sent");

      datos = { nombre, email, telefono }; // por si luego se reserva una cita

      const partes = [`${FT.name}: ${nombre}`, `${FT.email}: ${email}`];
      if (telefono) partes.push(`${FT.phone}: ${telefono}`);
      const texto = `${FT.summary} ${partes.join(". ")}.`;

      void send(texto, null);
    });

    function fail(msg?: string): void {
      error.textContent = msg || "";
    }

    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    el.querySelector<HTMLInputElement>("#lead-name")?.focus();
  }

  // ── "Que te llamemos" ────────────────────────────────────────────────────────

  /**
   * Pide teléfono y momento para devolver la llamada.
   *
   * La casilla de consentimiento no es la genérica de privacidad: es permiso expreso
   * para llamar a ese número. Se manda al servidor el texto literal que el visitante
   * aceptó, junto con la hora, porque una llamada comercial hay que poder justificarla.
   */
  function addLlamada(): void {
    if (!log || log.querySelector("[data-llamada]")) return; // solo una vez

    const cuandos: Array<[string, string]> = [
      ["manana", LT.whenMorning || ""],
      ["tarde", LT.whenAfternoon || ""],
      ["cualquiera", LT.whenAny || ""],
    ];
    const consentTexto = `${LT.consentPre || ""}${LT.consentLink || ""}.`;

    const el = document.createElement("form");
    el.className = "lead";
    el.setAttribute("data-llamada", "");
    el.noValidate = true;
    el.innerHTML = `
      <p class="lead__title">${LT.title || ""}</p>
      <p class="lead__intro">${LT.intro || ""}</p>
      <label class="lead__label" for="call-name">${FT.name || ""}</label>
      <input class="lead__input" id="call-name" name="nombre" type="text"
             placeholder="${FT.namePh || ""}" autocomplete="name"
             value="${(datos?.nombre || "").replace(/"/g, "&quot;")}" />
      <label class="lead__label" for="call-phone">${FT.phone || ""}</label>
      <input class="lead__input" id="call-phone" name="telefono" type="tel"
             placeholder="${FT.phonePh || ""}" autocomplete="tel" required
             value="${(datos?.telefono || "").replace(/"/g, "&quot;")}" />
      <p class="lead__label">${LT.when || ""}</p>
      <div class="llamada__cuando">
        ${cuandos
          .map(
            ([v, txt], i) =>
              `<label class="llamada__op"><input type="radio" name="cuando" value="${v}"${
                i === 2 ? " checked" : ""
              } /><span>${txt}</span></label>`
          )
          .join("")}
      </div>
      <label class="lead__consent">
        <input type="checkbox" name="consent" />
        <span>${LT.consentPre || ""}<a href="${D.privacy || "#"}" target="_blank" rel="noopener">${LT.consentLink || ""}</a>.</span>
      </label>
      <p class="lead__error" role="alert" aria-live="polite"></p>
      <button class="lead__submit" type="submit">${LT.submit || ""}</button>
    `;

    const error = el.querySelector<HTMLParagraphElement>(".lead__error")!;
    const button = el.querySelector<HTMLButtonElement>(".lead__submit")!;

    el.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(el);
      const nombre = String(data.get("nombre") || "").trim();
      const telefono = String(data.get("telefono") || "").trim();
      const cuando = String(data.get("cuando") || "cualquiera");

      const n = digitos(telefono).length;
      if (n < 9 || n > 15) return void (error.textContent = LT.errPhone || "");
      if (!data.get("consent")) return void (error.textContent = FT.errConsent || "");

      error.textContent = "";
      button.disabled = true;
      button.textContent = LT.sending || "…";

      try {
        const res = await fetch("/api/call", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ nombre, telefono, cuando, consentimiento: consentTexto, sessionId, origen: "chat" }),
        });
        if (!res.ok) throw new Error("bad");
      } catch {
        button.disabled = false;
        button.textContent = LT.submit || "";
        error.textContent = LT.failed || "";
        return;
      }

      // Se queda visible pero bloqueado: el visitante ve lo que dejó.
      el.querySelectorAll("input").forEach((i) => (i.disabled = true));
      el.classList.add("is-sent");

      datos = { nombre, email: datos?.email || "", telefono };

      const etiqueta = cuandos.find(([v]) => v === cuando)?.[1] || "";
      addMsg("bot", `✅ ${LT.done || ""} ${telefono}.`);
      void send(`${LT.summary} ${FT.phone}: ${telefono}. ${LT.when} ${etiqueta}.`, null);
    });

    log.appendChild(el);
    log.scrollTop = log.scrollHeight;
    el.querySelector<HTMLInputElement>("#call-phone")?.focus();
  }

  // ── Selector de cita ─────────────────────────────────────────────────────────

  type Hueco = { start: string; end: string };

  const dia = (iso: string, zona: string) =>
    new Intl.DateTimeFormat(LANG, { timeZone: zona, weekday: "long", day: "numeric", month: "long" })
      .format(new Date(iso));
  const hora = (iso: string, zona: string) =>
    new Intl.DateTimeFormat(LANG, { timeZone: zona, hour: "2-digit", minute: "2-digit", hour12: false })
      .format(new Date(iso));

  /**
   * Pinta el selector de día y hora.
   *
   * Los huecos vienen de /api/slots, que los calcula contra el calendario real. El
   * modelo no interviene: si inventara una hora, alguien se plantaría aquí un día
   * que no le esperamos.
   */
  async function addAgenda(): Promise<void> {
    if (!log || log.querySelector("[data-agenda]")) return; // solo una vez

    const el = document.createElement("div");
    el.className = "lead";
    el.setAttribute("data-agenda", "");
    el.innerHTML = `<p class="lead__title">${CT.title || ""}</p><p class="lead__intro">${CT.loading || ""}</p>`;
    log.appendChild(el);
    log.scrollTop = log.scrollHeight;

    let huecos: Hueco[] = [];
    let zona = "Europe/Madrid";
    try {
      const res = await fetch("/api/slots", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" });
      if (!res.ok) throw new Error("bad");
      const data = await res.json();
      huecos = Array.isArray(data.slots) ? data.slots : [];
      zona = data.zona || zona;
    } catch {
      el.innerHTML = `<p class="lead__title">${CT.title || ""}</p><p class="lead__intro">${CT.error || ""}</p>`;
      return;
    }

    if (!huecos.length) {
      el.innerHTML = `<p class="lead__title">${CT.title || ""}</p><p class="lead__intro">${CT.empty || ""}</p>`;
      return;
    }

    // Agrupados por día, en el orden en que llegan (ya vienen ordenados).
    const porDia = new Map<string, Hueco[]>();
    for (const h of huecos) {
      const clave = dia(h.start, zona);
      if (!porDia.has(clave)) porDia.set(clave, []);
      porDia.get(clave)!.push(h);
    }

    let diaActivo = [...porDia.keys()][0]!;
    let elegido: Hueco | null = null;

    const pintar = () => {
      const dias = [...porDia.keys()]
        .map((d) => `<button type="button" class="cita__dia${d === diaActivo ? " is-on" : ""}" data-dia="${d}">${d}</button>`)
        .join("");
      const horas = (porDia.get(diaActivo) || [])
        .map((h) => `<button type="button" class="cita__hora${elegido?.start === h.start ? " is-on" : ""}" data-hora="${h.start}">${hora(h.start, zona)}</button>`)
        .join("");

      el.innerHTML = `
        <p class="lead__title">${CT.title || ""}</p>
        <div class="cita__dias">${dias}</div>
        <p class="lead__label">${CT.pickTime || ""}</p>
        <div class="cita__horas">${horas}</div>
        ${elegido ? formulario() : ""}
        <p class="lead__error" role="alert" aria-live="polite"></p>
      `;
      enlazar();
    };

    const formulario = () => `
      <input class="lead__input" data-c-nombre type="text" placeholder="${FT.namePh || ""}"
             autocomplete="name" value="${(datos?.nombre || "").replace(/"/g, "&quot;")}" />
      <input class="lead__input" data-c-email type="email" placeholder="${FT.emailPh || ""}"
             autocomplete="email" value="${(datos?.email || "").replace(/"/g, "&quot;")}" />
      <input class="lead__input" data-c-tel type="tel" placeholder="${FT.phonePh || ""}"
             autocomplete="tel" value="${(datos?.telefono || "").replace(/"/g, "&quot;")}" />
      <label class="lead__consent">
        <input type="checkbox" data-c-consent ${datos ? "checked" : ""} />
        <span>${FT.consentPre || ""}<a href="${D.privacy || "#"}" target="_blank" rel="noopener">${FT.consentLink || ""}</a>.</span>
      </label>
      <button class="lead__submit" data-c-confirm type="button">${CT.confirm || ""}</button>
    `;

    function enlazar(): void {
      el.querySelectorAll<HTMLButtonElement>("[data-dia]").forEach((b) =>
        b.addEventListener("click", () => { diaActivo = b.dataset.dia!; elegido = null; pintar(); })
      );
      el.querySelectorAll<HTMLButtonElement>("[data-hora]").forEach((b) =>
        b.addEventListener("click", () => {
          elegido = huecos.find((h) => h.start === b.dataset.hora) || null;
          pintar();
        })
      );
      el.querySelector<HTMLButtonElement>("[data-c-confirm]")?.addEventListener("click", confirmar);
      log!.scrollTop = log!.scrollHeight;
    }

    async function confirmar(): Promise<void> {
      const error = el.querySelector<HTMLElement>(".lead__error")!;
      const boton = el.querySelector<HTMLButtonElement>("[data-c-confirm]")!;
      const nombre = el.querySelector<HTMLInputElement>("[data-c-nombre]")!.value.trim();
      const email = el.querySelector<HTMLInputElement>("[data-c-email]")!.value.trim();
      const telefono = el.querySelector<HTMLInputElement>("[data-c-tel]")!.value.trim();

      if (!nombre) return void (error.textContent = FT.errName || "");
      if (!EMAIL_RE.test(email)) return void (error.textContent = FT.errEmail || "");
      if (!el.querySelector<HTMLInputElement>("[data-c-consent]")!.checked) {
        return void (error.textContent = FT.errConsent || "");
      }

      error.textContent = "";
      boton.disabled = true;
      boton.textContent = CT.booking || "…";

      try {
        const res = await fetch("/api/book", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ start: elegido!.start, nombre, email, telefono }),
        });

        if (res.status === 409) {
          // Alguien se adelantó mientras elegía: se recarga en vez de mentirle.
          el.removeAttribute("data-agenda");
          el.remove();
          addMsg("bot", CT.taken || "");
          datos = { nombre, email, telefono };
          void addAgenda();
          return;
        }
        if (!res.ok) throw new Error("bad");

        datos = { nombre, email, telefono };
        const cuando = `${dia(elegido!.start, zona)}, ${hora(elegido!.start, zona)}`;
        el.remove();
        addMsg("bot", `✅ ${cuando}`);
        void send(`${CT.doneMsg} ${cuando}.`, null);
      } catch {
        boton.disabled = false;
        boton.textContent = CT.confirm || "";
        error.textContent = CT.failed || "";
      }
    }

    pintar();
  }
</script>

<style>
  .chat { position: fixed; right: 20px; bottom: 20px; z-index: 90; }

  .chat__launcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-gold);
    color: var(--color-bg);
    border: 0;
    border-radius: 999px;
    padding: 13px 20px 13px 15px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
    transition: background-color 0.2s ease;
  }
  .chat__launcher:hover { background: var(--color-gold-soft); }
  .chat__launcher-icon { display: inline-flex; }
  .chat.is-open .chat__launcher { display: none; }

  .chat__panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(370px, calc(100vw - 32px));
    height: min(560px, calc(100vh - 40px));
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border-2);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7);
  }
  .chat__panel[hidden] { display: none; }

  .chat__header {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 14px 16px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .chat__avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-gold); color: var(--color-bg);
    display: flex; align-items: center; justify-content: center; flex: none;
  }
  .chat__id { display: flex; flex-direction: column; line-height: 1.3; }
  .chat__name { font-size: 14px; font-weight: 500; }
