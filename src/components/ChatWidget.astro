---
import Icon from "./Icon.astro";
---
<div class="chat" data-chat>
  <button class="chat__launcher" data-chat-launcher aria-label="Abrir asistente de Escalar" aria-expanded="false">
    <span class="chat__launcher-icon"><Icon name="robot" size={24} /></span>
    <span class="chat__launcher-text">¿Hablamos?</span>
  </button>

  <section class="chat__panel" data-chat-panel hidden aria-label="Asistente de Escalar">
    <header class="chat__header">
      <span class="chat__avatar"><Icon name="robot" size={20} /></span>
      <div class="chat__id">
        <span class="chat__name">Asistente de Escalar</span>
        <span class="chat__state"><span class="chat__dot"></span>en línea</span>
      </div>
      <button class="chat__close" data-chat-close aria-label="Cerrar chat">✕</button>
    </header>

    <div class="chat__log" data-chat-log>
      <div class="msg msg--bot">
        ¡Hola! Soy el asistente de Escalar. Cuéntame qué te gustaría dejar de hacer a mano en tu
        negocio y te digo cómo podríamos automatizarlo.
      </div>
    </div>

    <form class="chat__form" data-chat-form>
      <input
        class="chat__input"
        data-chat-input
        type="text"
        placeholder="Escribe tu mensaje…"
        autocomplete="off"
        aria-label="Tu mensaje"
      />
      <button class="chat__send" type="submit" aria-label="Enviar"><Icon name="send" size={18} /></button>
    </form>
    <p class="chat__legal">Al escribir aceptas nuestra <a href="/privacidad">política de privacidad</a>.</p>
  </section>
</div>

<script>
  type Msg = { role: "user" | "assistant"; content: string };

  const root = document.querySelector("[data-chat]");
  const launcher = document.querySelector<HTMLButtonElement>("[data-chat-launcher]");
  const panel = document.querySelector<HTMLElement>("[data-chat-panel]");
  const log = document.querySelector<HTMLElement>("[data-chat-log]");
  const form = document.querySelector<HTMLFormElement>("[data-chat-form]");
  const input = document.querySelector<HTMLInputElement>("[data-chat-input]");
  const history: Msg[] = [];

  function open() {
    panel?.removeAttribute("hidden");
    launcher?.setAttribute("aria-expanded", "true");
    root?.classList.add("is-open");
    setTimeout(() => input?.focus(), 60);
  }
  function close() {
    panel?.setAttribute("hidden", "");
    launcher?.setAttribute("aria-expanded", "false");
    root?.classList.remove("is-open");
  }
  function toggle() {
    if (panel?.hasAttribute("hidden")) open();
    else close();
  }

  launcher?.addEventListener("click", toggle);
  document.querySelector("[data-chat-close]")?.addEventListener("click", close);
  document.querySelectorAll("[data-open-chat]").forEach((b) =>
    b.addEventListener("click", (e) => { e.preventDefault(); open(); })
  );

  function addMsg(role: "user" | "bot", text: string): HTMLElement {
    const el = document.createElement("div");
    el.className = `msg msg--${role}`;
    el.textContent = text;
    log?.appendChild(el);
    if (log) log.scrollTop = log.scrollHeight;
    return el;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const text = input?.value.trim();
    if (!text) return;
    if (input) input.value = "";
    addMsg("user", text);
    history.push({ role: "user", content: text });

    const typing = addMsg("bot", "…");
    typing.classList.add("msg--typing");

    try {
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });
      if (!res.ok) throw new Error("bad");
      const data = await res.json();
      const reply = (data && data.reply) || "Perdona, no te he entendido. ¿Puedes repetírmelo?";
      typing.classList.remove("msg--typing");
      typing.textContent = reply;
      history.push({ role: "assistant", content: reply });
    } catch {
      typing.classList.remove("msg--typing");
      typing.innerHTML =
        'Ahora mismo no puedo responder. Escríbenos a <a href="mailto:hola@escalar.es">hola@escalar.es</a> y te atendemos enseguida.';
    }
    if (log) log.scrollTop = log.scrollHeight;
  });
</script>

<style>
  .chat { position: fixed; right: 20px; bottom: 20px; z-index: 90; }

  .chat__launcher {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--color-gold);
    color: var(--color-bg);
    border: 0;
    border-radius: 999px;
    padding: 13px 20px 13px 15px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
    transition: background-color 0.2s ease;
  }
  .chat__launcher:hover { background: var(--color-gold-soft); }
  .chat__launcher-icon { display: inline-flex; }
  .chat.is-open .chat__launcher { display: none; }

  .chat__panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(370px, calc(100vw - 32px));
    height: min(560px, calc(100vh - 40px));
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border-2);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.7);
  }
  .chat__panel[hidden] { display: none; }

  .chat__header {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 14px 16px;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }
  .chat__avatar {
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-gold); color: var(--color-bg);
    display: flex; align-items: center; justify-content: center; flex: none;
  }
  .chat__id { display: flex; flex-direction: column; line-height: 1.3; }
  .chat__name { font-size: 14px; font-weight: 500; }
  .chat__state { font-size: 12px; color: #5dcaa5; display: flex; align-items: center; gap: 6px; }
  .chat__dot { width: 7px; height: 7px; border-radius: 50%; background: #5dcaa5; }
  .chat__close {
    margin-left: auto; background: none; border: 0; color: var(--color-text-2);
    font-size: 16px; cursor: pointer; padding: 6px; line-height: 1;
    transition: color 0.2s ease;
  }
  .chat__close:hover { color: var(--color-text); }

  .chat__log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .msg {
    max-width: 85%;
    padding: 10px 13px;
    font-size: 14px;
    line-height: 1.5;
    border-radius: 14px;
  }
  .msg--bot {
    align-self: flex-start;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-bottom-left-radius: 4px;
  }
  .msg--bot :global(a) { color: var(--color-gold); }
  .msg--user {
    align-self: flex-end;
    background: var(--color-gold);
    color: var(--color-bg);
    border-bottom-right-radius: 4px;
  }
  .msg--typing { color: var(--color-muted); letter-spacing: 2px; }

  .chat__form {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid var(--color-border);
  }
  .chat__input {
    flex: 1;
    font-family: inherit;
    font-size: 14px;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-2);
    border-radius: 10px;
    padding: 11px 13px;
  }
  .chat__input:focus { outline: none; border-color: var(--color-gold); }
  .chat__input::placeholder { color: var(--color-muted); }
  .chat__send {
    flex: none;
    width: 42px;
    border: 0;
    border-radius: 10px;
    background: var(--color-gold);
    color: var(--color-bg);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background-color 0.2s ease;
  }
  .chat__send:hover { background: var(--color-gold-soft); }
  .chat__legal { font-size: 11px; color: var(--color-muted); text-align: center; padding: 0 12px 12px; }
  .chat__legal a { color: var(--color-text-2); }
</style>
