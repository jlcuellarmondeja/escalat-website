---
import { useT } from "../i18n/ui";
const t = useT(Astro.currentLocale).sobre;
---
<section class="section" id="sobre">
  <div class="container sobre__grid">
    <div class="sobre__intro reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-intro">{t.intro}</p>
      <p class="sobre__text">
        {t.textPre}<span class="text-gold">{t.textAccent}</span>{t.textPost}
      </p>
    </div>

    <ul class="sobre__valores reveal">
      {t.valores.map((v) => (
        <li>
          <h3>{v.title}</h3>
          <p>{v.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sobre__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .sobre__text { margin-top: 18px; color: var(--color-text-2); font-size: 17px; }
  .sobre__valores { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .sobre__valores li { padding: 20px 0; border-bottom: 1px solid var(--color-border); }
  .sobre__valores li:last-child { border-bottom: 0; }
  .sobre__valores h3 { font-size: 20px; margin-bottom: 6px; }
  .sobre__valores p { color: var(--color-text-2); font-size: 15.5px; }

  @media (max-width: 820px) {
    .sobre__grid { grid-template-columns: 1fr; }
  }
</style>
