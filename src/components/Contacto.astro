---
import Icon from "./Icon.astro";
import { WHATSAPP_NUMBER, CONTACT_EMAIL } from "../config";
import { useT, getLang, legalPaths } from "../i18n/ui";
const t = useT(Astro.currentLocale).contacto;
const privacyHref = legalPaths[getLang(Astro.currentLocale)].privacy;
---
<section class="section section--alt" id="contacto">
  <div class="container contacto__grid">
    <div class="contacto__intro reveal">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-intro">{t.intro}</p>

      <div class="contacto__actions">
        <button class="btn btn-primary" data-open-chat>
          <Icon name="robot" size={18} /> {t.ctaChat}
        </button>
      </div>

      <ul class="contacto__alt">
        <li>
          <Icon name="chat" size={18} />
          <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener">{t.waDirect}</a>
        </li>
        <li>
          <Icon name="send" size={18} />
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </li>
      </ul>
    </div>

    <div class="contacto__card reveal">
      <h3 class="contacto__card-title">{t.formTitle}</h3>
      <p class="contacto__card-sub">{t.formSub}</p>

      <form
        class="callback-form"
        data-callback-form
        data-wa-intro={t.waIntro}
        data-wa-call={t.waCallText}
        data-wa-phone={t.waPhone}
        data-wa-when={t.waWhen}
        data-wa-need={t.waNeed}
        data-status-ok={t.statusOk}
        novalidate
      >
        <div class="field">
          <label for="cb-name">{t.labelName}</label>
          <input id="cb-name" name="name" type="text" autocomplete="name" required placeholder={t.phName} />
        </div>
        <div class="field">
          <label for="cb-phone">{t.labelPhone}</label>
          <input id="cb-phone" name="phone" type="tel" autocomplete="tel" required placeholder={t.phPhone} />
        </div>
        <div class="field">
          <label for="cb-when">{t.labelWhen}</label>
          <select id="cb-when" name="when">
            <option value={t.whenMorning}>{t.whenMorning}</option>
            <option value={t.whenAfternoon}>{t.whenAfternoon}</option>
            <option value={t.whenAny}>{t.whenAny}</option>
          </select>
        </div>
        <div class="field">
          <label for="cb-msg">{t.labelMsg} <span class="opt">{t.optional}</span></label>
          <textarea id="cb-msg" name="message" rows="3" placeholder={t.phMsg}></textarea>
        </div>

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>{t.consentPre}<a href={privacyHref}>{t.consentLink}</a>{t.consentPost}</span>
        </label>

        <button type="submit" class="btn btn-primary callback-form__submit">{t.submit}</button>
        <p class="callback-form__status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  import { waLink } from "../config";

  const form = document.querySelector<HTMLFormElement>("[data-callback-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    const d = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    const s = form.dataset;

    const msg =
      `${s.waIntro} ${d.name}. ${s.waCall}` +
      `\n${s.waPhone}: ${d.phone}` +
      (d.when ? `\n${s.waWhen}: ${d.when}` : "") +
      (d.message ? `\n${s.waNeed}: ${d.message}` : "");

    window.open(waLink(msg), "_blank", "noopener");

    form.reset();
    if (status) {
      status.textContent = s.statusOk || "";
      status.className = "callback-form__status is-ok";
    }
  });
</script>

<style>
  .contacto__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 64px);
    align-items: start;
  }
  .contacto__actions { margin-top: 28px; }
  .contacto__alt { list-style: none; padding: 0; margin-top: 26px; display: flex; flex-direction: column; gap: 12px; }
  .contacto__alt li { display: flex; align-items: center; gap: 10px; color: var(--color-text-2); }
  .contacto__alt :global(svg) { color: var(--color-gold); }
  .contacto__alt a { transition: color 0.2s ease; }
  .contacto__alt a:hover { color: var(--color-gold-soft); }

  .contacto__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: clamp(24px, 4vw, 36px);
  }
  .contacto__card-title { font-size: 24px; }
  .contacto__card-sub { color: var(--color-text-2); font-size: 15px; margin: 8px 0 24px; }

  .field { margin-bottom: 16px; display: flex; flex-direction: column; gap: 7px; }
  .field label { font-size: 14px; color: var(--color-text-2); }
  .field .opt { color: var(--color-muted); }
  .field input, .field select, .field textarea {
    font-family: inherit;
    font-size: 15px;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border-2);
    border-radius: var(--radius);
    padding: 12px 14px;
    width: 100%;
    transition: border-color 0.2s ease;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--color-gold);
  }
  .field input::placeholder, .field textarea::placeholder { color: var(--color-muted); }

  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; color: var(--color-text-2); margin: 6px 0 20px; }
  .consent input { margin-top: 3px; accent-color: var(--color-gold); }
  .consent a { color: var(--color-gold); }

  .callback-form__submit { width: 100%; }
  .callback-form__status { margin-top: 14px; font-size: 14px; min-height: 1em; }
  .callback-form__status.is-ok { color: var(--color-gold-soft); }
  .callback-form__status.is-err { color: #e08a7a; }
  .callback-form__status :global(a) { color: var(--color-gold); }

  @media (max-width: 820px) {
    .contacto__grid { grid-template-columns: 1fr; }
  }
</style>
