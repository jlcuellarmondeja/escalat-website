---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";

interface Props {
  title?: string;
  description?: string;
  showChat?: boolean;
}

const {
  title = "Escalar — Soluciones informáticas con IA para pymes",
  description =
    "Automatizamos la atención al cliente, la agenda y las tareas repetitivas de tu negocio con inteligencia artificial. Para que una sola persona pueda con todo.",
  showChat = true,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta name="theme-color" content="#14151a" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#contenido" class="sr-only">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {showChat && <ChatWidget />}

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
