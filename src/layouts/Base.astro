---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/tokens.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { useT, getLang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  showChat?: boolean;
  alternates?: { es?: string; en?: string };
}

const lang = getLang(Astro.currentLocale);

const defaults = {
  es: {
    title: "Escalat — Soluciones informáticas con IA para pymes",
    description:
      "Automatizamos la atención al cliente, la agenda y las tareas repetitivas de tu negocio con inteligencia artificial. Para que una sola persona pueda con todo.",
  },
  en: {
    title: "Escalat — AI-powered IT solutions for small businesses",
    description:
      "We automate your customer support, scheduling and repetitive tasks with artificial intelligence, so one person can run the whole business.",
  },
};

const {
  title = defaults[lang].title,
  description = defaults[lang].description,
  showChat = true,
  alternates,
} = Astro.props;

const skip = useT(Astro.currentLocale).skip;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const altUrl = (p?: string) => (p && Astro.site ? new URL(p, Astro.site).href : p);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {alternates && (
      <>
        {alternates.es && <link rel="alternate" hreflang="es" href={altUrl(alternates.es)} />}
        {alternates.en && <link rel="alternate" hreflang="en" href={altUrl(alternates.en)} />}
        {alternates.es && <link rel="alternate" hreflang="x-default" href={altUrl(alternates.es)} />}
      </>
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />
    <meta name="theme-color" content="#14151a" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#contenido" class="sr-only">{skip}</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    {showChat && <ChatWidget />}

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
